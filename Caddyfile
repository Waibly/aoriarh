	<script>
	(function () {
	  var tries = 0;
	  function check() {
	    tries += 1;
	    fetch(window.location.href, { cache: "no-store", credentials: "same-origin" })
	      .then(function (res) {
	        if (res.ok && !res.headers.get("X-Aoria-Maintenance")) { window.location.reload(); return; }
	        schedule();
	      })
	      .catch(schedule);
	  }
	  function schedule() {
	    if (tries === 24) {
	      document.getElementById("status").textContent = "La mise à jour prend un peu plus longtemps que prévu. La page continue de vérifier toute seule.";
	    }
	    window.setTimeout(check, 5000);
	  }
	  window.setTimeout(check, 5000);
	})();
	</script>
	</body>
	</html>
